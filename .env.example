# Copy this file to .env.local (git-ignored) and fill it in.
GNEWS_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
# ElevenLabs voice used to narrate the episode (required for audio). Pick a voice available to your account and copy its id from https://elevenlabs.io/app/voices
ELEVENLABS_VOICE_ID=
# The voice is server configuration only: the app has no voice setting and the browser never sees this id.
# Text-to-speech model. eleven_multilingual_v2 accepts 10,000 characters per request; episodes are always 9 minutes
# long precisely so the script stays under that in one request. Supported: eleven_multilingual_v2, eleven_flash_v2_5,
# eleven_flash_v2, eleven_v3 (the last three have higher limits, for a longer episode). Anything else is refused before an episode starts.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: override the model used for story ranking (default gpt-5-mini).
# OPENAI_RANKING_MODEL=
# Optional: override the model for the script writer (gpt-5.5, at medium reasoning effort).
# OPENAI_SCRIPT_MODEL=
# Optional: override the model for the episode planner and the script validator's AI review (default gpt-5-mini each).
# They do not follow OPENAI_SCRIPT_MODEL: each stage is set on its own.
# OPENAI_PLANNER_MODEL=
# OPENAI_VALIDATOR_MODEL=
# Optional: override the model used for story research, i.e. source selection and synthesis (default gpt-5-mini).
# OPENAI_RESEARCH_MODEL=
# Optional: where generated episode MP3s are stored (default .generated/episodes in the project; the temp directory on Vercel).
# EPISODE_STORAGE_DIR=
